# Generated by Terraform (terraform output -raw ansible_inventory). Do not edit by hand.
all:
  vars:
    app_env: ${environment}
    aws_region: ${aws_region}
    target_group_arn: "${target_group_arn}"
    site_url: "${site_url}"
  children:
    web:
      hosts:
%{ for s in servers ~}
        ${s.name}:
          ansible_host: ${s.ip}
          instance_id: ${s.instance_id}
%{ endfor ~}
